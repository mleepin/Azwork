{
	"name": "DataFlowType2Jul24",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTableType2",
						"type": "DatasetReference"
					},
					"name": "sourceexisting"
				},
				{
					"dataset": {
						"referenceName": "DelimitedTextType2Jul24",
						"type": "DatasetReference"
					},
					"name": "sourcenewchanges"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "DerivedColumnHashColumns"
				},
				{
					"name": "filter2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "join1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select1"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "exists2"
				},
				{
					"name": "ModifyColumns1",
					"description": "Autogenerated by data preview actions"
				},
				{
					"name": "ModifyColumns2",
					"description": "Autogenerated by data preview actions"
				}
			],
			"scriptLines": [
				"parameters{",
				"     PK as string ('ID'),",
				"     COLS as string ('Name, Group, Value')",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceexisting",
				"source(output(",
				"          Name as string,",
				"          ID as string,",
				"          Group as string,",
				"          Value as string,",
				"          Start as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> sourcenewchanges",
				"ModifyColumns2 filter(!isNull(byName('ID'))) ~> filter1",
				"filter1 derive(ID_Hash = md5(byNames(split($PK,','))),",
				"          Cols_Hash = md5(byNames(split($COLS,',')))) ~> DerivedColumnHashColumns",
				"sourceexisting filter(byName('Active') == 'Y') ~> filter2",
				"filter2 derive(ID_Hash = md5(byNames(split($PK,','))),",
				"          Cols_Hash = md5(byNames(split($COLS,',')))) ~> derivedColumn1",
				"derivedColumn1, ModifyColumns1 exists(DerivedColumnHashColumns@ID_Hash == derivedColumn1@ID_Hash",
				"     && DerivedColumnHashColumns@Cols_Hash == derivedColumn1@Cols_Hash,",
				"     negate:true,",
				"     broadcast: 'auto')~> exists1",
				"surrogateKey1, derivedColumn1 join(1==1,",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"exists1 keyGenerate(output(Keynew as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"join1 derive(Key = toInteger(byName('MaxKey'))   +  toInteger(byName('Keynew')),",
				"          Active = \"Y\",",
				"          End = toTimestamp(toString(null())),",
				"          StartNew = toTimestamp(toString('start'))) ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          Name,",
				"          ID,",
				"          Group,",
				"          Value,",
				"          Key,",
				"          Active,",
				"          Start,",
				"          End",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1 aggregate(MaxKey = max(byName('Key'))) ~> aggregate2",
				"DerivedColumnHashColumns, derivedColumn1 exists(DerivedColumnHashColumns@ID_Hash == derivedColumn1@ID_Hash,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists2",
				"DerivedColumnHashColumns derive(ID = toInteger(ID)) ~> ModifyColumns1",
				"sourcenewchanges derive(ID = toInteger(ID),",
				"          Value = toInteger(Value)) ~> ModifyColumns2"
			]
		}
	}
}