{
	"name": "DataFlowType2Jul24",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTableType2",
						"type": "DatasetReference"
					},
					"name": "sourceexisting"
				},
				{
					"dataset": {
						"referenceName": "DelimitedTextType2Jul24",
						"type": "DatasetReference"
					},
					"name": "sourcenewchanges"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "filter2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "aggregate2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     PK as string ('ID'),",
				"     COLS as string ('Name, Group, Value')",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceexisting",
				"source(output(",
				"          Name as string,",
				"          ID as string,",
				"          Group as string,",
				"          Value as string,",
				"          Start as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> sourcenewchanges",
				"sourceexisting filter(byName('Active') == 'Y') ~> filter2",
				"filter2 derive(ID_Hash = md5(byNames(split($PK,','))),",
				"          Cols_Hash = md5(byNames(split($COLS,',')))) ~> derivedColumn1",
				"derivedColumn1, sourcenewchanges exists(DerivedColumnHashColumns@ID_Hash == derivedColumn1@ID_Hash,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"derivedColumn1 aggregate(MaxKey = max(byName('Key'))) ~> aggregate2"
			]
		}
	}
}