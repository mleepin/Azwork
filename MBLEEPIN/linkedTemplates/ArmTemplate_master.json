{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "MBLEEPIN"
		},
		"AzBlobStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzBlobStorage'"
		},
		"Azuremlee_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Azuremlee'"
		},
		"Azuremlee_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "mleep.database.windows.net"
		},
		"Azuremlee_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "mlee"
		},
		"Azuremlee_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mleepin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "MBLEEPIN_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2018-02-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzBlobStorage_connectionString": {
						"value": "[parameters('AzBlobStorage_connectionString')]"
					},
					"Azuremlee_password": {
						"value": "[parameters('Azuremlee_password')]"
					},
					"Azuremlee_properties_typeProperties_server": {
						"value": "[parameters('Azuremlee_properties_typeProperties_server')]"
					},
					"Azuremlee_properties_typeProperties_database": {
						"value": "[parameters('Azuremlee_properties_typeProperties_database')]"
					},
					"Azuremlee_properties_typeProperties_userName": {
						"value": "[parameters('Azuremlee_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}