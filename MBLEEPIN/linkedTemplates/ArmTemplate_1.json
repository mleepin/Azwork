{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "MBLEEPIN"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DataFlowType2Jul24')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "AzureSqlTableType2",
								"type": "DatasetReference"
							},
							"name": "sourceexisting"
						},
						{
							"dataset": {
								"referenceName": "DelimitedTextType2Jul24",
								"type": "DatasetReference"
							},
							"name": "sourcenewchanges"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "AzureSqlTableType2",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "filter2"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "exists1"
						},
						{
							"name": "aggregate2"
						},
						{
							"name": "ModifyColumns1",
							"description": "Autogenerated by data preview actions"
						},
						{
							"name": "filter3"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "exists2"
						},
						{
							"name": "surrogateKey1"
						},
						{
							"name": "join1"
						},
						{
							"name": "derivedColumn3"
						},
						{
							"name": "select1"
						},
						{
							"name": "alterRow1"
						},
						{
							"name": "derivedColumn4"
						},
						{
							"name": "alterRow2"
						},
						{
							"name": "select2"
						},
						{
							"name": "union1"
						}
					],
					"scriptLines": [
						"parameters{",
						"     PK as string ('ID'),",
						"     COLS as string ('Name,Group,Value')",
						"}",
						"source(output(",
						"          Name as string,",
						"          ID as integer,",
						"          Group as string,",
						"          Value as integer,",
						"          Key as integer,",
						"          Active as string,",
						"          Start as timestamp,",
						"          End as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     limit: 100,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourceexisting",
						"source(output(",
						"          Name as string,",
						"          ID as string,",
						"          Group as string,",
						"          Value as string,",
						"          Start as timestamp 'yyyy-MM-dd\\'T\\'HH:mm:ss'",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> sourcenewchanges",
						"sourceexisting filter(byName('Active') == 'Y') ~> filter2",
						"filter2 derive(ID_Hash = md5(byNames(split($PK,','))),",
						"          Cols_Hash = md5(byNames(split($COLS,',')))) ~> derivedColumn1",
						"derivedColumn1, derivedColumn2 exists(ID_Hash == IDHashNew,",
						"     negate:false,",
						"     broadcast: 'auto')~> exists1",
						"derivedColumn1 aggregate(MaxKey = max(byName('Key'))) ~> aggregate2",
						"sourcenewchanges derive(ID = toInteger(ID),",
						"          Value = toInteger(Value)) ~> ModifyColumns1",
						"ModifyColumns1 filter(!isNull(byName('ID'))) ~> filter3",
						"filter3 derive(IDHashNew = md5(byNames(split($PK,','))),",
						"          ColsHashNew = md5(byNames(split($COLS,',')))) ~> derivedColumn2",
						"derivedColumn2, derivedColumn1 exists(IDHashNew == ID_Hash",
						"     && ColsHashNew == Cols_Hash,",
						"     negate:true,",
						"     broadcast: 'auto')~> exists2",
						"exists2 keyGenerate(output(KeyNew as long),",
						"     startAt: 1L,",
						"     stepValue: 1L) ~> surrogateKey1",
						"surrogateKey1, aggregate2 join(1==1,",
						"     joinType:'cross',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"join1 derive(Active = \"Y\",",
						"          End = toTimestamp(null()),",
						"          Key = toInteger(byName('MaxKey'))  +  KeyNew) ~> derivedColumn3",
						"derivedColumn3 select(mapColumn(",
						"          Name,",
						"          ID,",
						"          Group,",
						"          Value,",
						"          Key,",
						"          Active,",
						"          Start = sourcenewchanges@Start,",
						"          End",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 alterRow(insertIf(true())) ~> alterRow1",
						"exists1 derive(Active = \"N\",",
						"          End = currentUTC()) ~> derivedColumn4",
						"derivedColumn4 alterRow(updateIf(true())) ~> alterRow2",
						"alterRow2 select(mapColumn(",
						"          Name,",
						"          ID,",
						"          Group,",
						"          Value,",
						"          Key,",
						"          Active,",
						"          Start,",
						"          End",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"select2, alterRow1 union(byName: true)~> union1",
						"union1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/PipelineType2DimLoad')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Data flow1",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DataFlowType2Jul24",
								"type": "DataFlowReference",
								"parameters": {
									"PK": "'ID'",
									"COLS": "'Name, Group, Value'"
								},
								"datasetParameters": {
									"sourceexisting": {
										"Table": "T2customer"
									},
									"sourcenewchanges": {
										"Folder": "Type2TuteJul24"
									},
									"sink1": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/DataFlowType2Jul24')]"
			]
		}
	]
}