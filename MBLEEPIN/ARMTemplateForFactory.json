					"scriptLines": [
						"parameters{",
						"     PK as string ('ID'),",
						"     COLS as string ('Name,Group,Value')",
						"}",
						"source(output(",
						"          Name as string,",
						"          ID as integer,",
						"          Group as string,",
						"          Value as integer,",
						"          Key as integer,",
						"          Active as string,",
						"          Start as timestamp,",
						"          End as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     limit: 100,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourceexisting",
						"source(output(",
						"          Name as string,",
						"          ID as string,",
						"          Group as string,",
						"          Value as string,",
						"          Start as timestamp 'yyyy-MM-dd\\'T\\'HH:mm:ss'",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> sourcenewchanges",
						"sourceexisting filter(byName('Active') == 'Y') ~> filter2",
						"filter2 derive(ID_Hash = md5(byNames(split($PK,','))),",
						"          Cols_Hash = md5(byNames(split($COLS,',')))) ~> derivedColumn1",
						"derivedColumn1, derivedColumn2 exists(ID_Hash == IDHashNew,",
