						"derivedColumn4 alterRow(updateIf(true())) ~> alterRow2",
						"alterRow2 select(mapColumn(",
						"          Name,",
						"          ID,",
						"          Group,",
						"          Value,",
						"          Key,",
						"          Active,",
						"          Start,",
						"          End",
						"     ),",
